# ── Local dev (`npm run dev`) ─────────────────────────────────────────
# Leave VITE_API_BASE unset so the app calls `/api/...` and Vite proxies to
# http://localhost:8000 (see vite.config.ts). Run the FastAPI backend on 8000.
#
# Optional: call the API directly (must match CORS on the backend):
# VITE_API_BASE=http://localhost:8000

# ── Production (`vite build`) ─────────────────────────────────────────
# Baked URL is in `.env.production` (Railway or your API host). No trailing slash.

# Google OAuth Web Client ID (same as backend GOOGLE_CLIENT_ID).
# In Google Cloud Console → Credentials → your Web client → Authorized JavaScript origins,
# add each URL you use exactly (e.g. http://localhost:5173 and https://your-app.vercel.app).
# Omitting this causes Error 400: origin_mismatch.
VITE_GOOGLE_CLIENT_ID=

# YouTube dev UI (localhost + toggle). Production: false in .env.production
VITE_ENABLE_YOUTUBE=true

# Backend: in `backend/.env` set ALLOW_YOUTUBE_API=true or the API returns
# "YouTube API is disabled on this server" when the dev toggle loads tracks.
